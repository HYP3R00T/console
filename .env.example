# Machine names, project directories, and model defaults are edited in Console > Machines.
# Optional service bootstrap configuration. Copy this file to .env if needed.
# Mise loads .env when running tasks. Restart mise run dev after changing it.
# If unset: $XDG_DATA_HOME/console or ~/.local/share/console
# Changing this selects a different database set; it does not migrate old data.
# CONSOLE_DATA_DIR="/absolute/path/to/console-data"
# Required on a backend accessed remotely. Use a long randomly generated value.
# The local Next.js proxy also reads this value for its own backend requests.
# CONSOLE_ACCESS_TOKEN="replace-with-a-random-secret"
# Bind beyond loopback only behind HTTPS, or keep loopback and use an SSH tunnel.
# HOST="127.0.0.1"
