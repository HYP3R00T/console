{
  "name": "@console/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "access": "node src/access/cli.ts"
  },
  "dependencies": {
    "@console/contracts": "workspace:*",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-env": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@fastify/cors": "^11.3.1",
    "cron-parser": "^5.10.4",
    "fastify": "5.12.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
